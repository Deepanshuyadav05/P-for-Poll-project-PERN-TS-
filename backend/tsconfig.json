{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",              //tells that all our source file will be in our src directory
    "outDir": "./dist",              //tells that all our compiled file will be in our dist directory


    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",                  // tells the compiler which module system to use (import/export)
    "target": "esnext",                   // tells the compiler which version of JS to compile to

    // For nodejs:
    "lib": ["esnext"],                     // specifies the global APIs that are available in our code
    "types": ["node"],                     // specifies the global types that are available in our code (nodejs)
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    //Add `undefined` to a type when accessed using an index like array
    "noUncheckedIndexedAccess": true,
    // Normally, TypeScript treats "property is optional" and "property's value can be undefined" as basically the same thing. exactOptionalPropertyTypes: true splits them apart
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
